{
  "category": "net",
  "directions": [
    {
      "id": "d_net_net",
      "name": "计算机网络",
      "en": "Computer Networks",
      "desc": "研究异构节点之间如何分组交换、路由与拥塞控制，是互联网与数据中心网络的共同基础。",
      "base": [
        {"n": "分层与协议体系", "t": "OSI 七层、TCP/IP 四层、封装/分用、MTU 与分片", "l": "—", "s": "Wireshark、tcpdump"},
        {"n": "链路与以太网", "t": "帧结构、MAC 寻址、VLAN、ARP、生成树", "l": "—", "s": "—"}
      ],
      "branches": [
        {
          "name": "传输与协议体系",
          "desc": "在不可靠的 IP 之上构建可靠、公平、低时延的数据通道。",
          "points": [
            {"n": "可靠传输与拥塞控制", "t": "滑动窗口、重传、RTT 估计、CUBIC/BBR、AQM", "l": "C", "s": "Linux TCP、netem"},
            {"n": "现代传输协议", "t": "QUIC、HTTP/3、多路复用、0-RTT、连接迁移", "l": "Rust、C++", "s": "quiche、nghttp3、msquic"},
            {"n": "应用层协议", "t": "DNS、HTTP、gRPC、WebSocket、MQTT", "l": "—", "s": "curl、Envoy、CoreDNS"}
          ]
        },
        {
          "name": "路由与网络架构",
          "desc": "决定分组走哪条路，以及数据中心内部如何组织东西向流量。",
          "points": [
            {"n": "路由协议", "t": "距离矢量、链路状态、BGP 策略、MPLS/SRv6", "l": "—", "s": "FRRouting、BIRD、Mininet"},
            {"n": "数据中心网络", "t": "叶脊架构、RDMA、无损以太网、等价多路径", "l": "—", "s": "RoCEv2、InfiniBand、SONiC"},
            {"n": "内容分发与边缘", "t": "CDN、缓存一致性、Anycast、边缘调度", "l": "—", "s": "Nginx、Varnish、Cloudflare"}
          ]
        },
        {
          "name": "可编程网络与高性能数据面",
          "desc": "把网络设备变成可编程的，用软件定义转发行为。",
          "points": [
            {"n": "SDN 与 P4", "t": "控制面/数据面分离、P4 流水线、OpenFlow、INT", "l": "P4", "s": "P4Runtime、BMv2、Open vSwitch"},
            {"n": "内核旁路与协议栈优化", "t": "DPDK、XDP/eBPF、零拷贝、用户态协议栈", "l": "C、eBPF", "s": "DPDK、VPP、Cilium"}
          ]
        },
        {
          "name": "无线与移动网络",
          "desc": "面向广播介质、移动性与功耗约束的接入技术。",
          "points": [
            {"n": "无线接入", "t": "802.11、5G NR、调度与切换、MIMO", "l": "—", "s": "srsRAN、OpenAirInterface、ns-3"},
            {"n": "低功耗广域与卫星", "t": "LoRa、NB-IoT、LEO 星座组网、星间链路", "l": "—", "s": "ChirpStack、STK"}
          ]
        },
        {
          "name": "网络测量与运维",
          "desc": "看不见的网络无法优化：用测量数据驱动容量规划与故障定位。",
          "points": [
            {"n": "测量与遥测", "t": "主动/被动测量、带内遥测、流量分类、根因分析", "l": "—", "s": "perfSONAR、nDPI、Prometheus"}
          ]
        }
      ]
    },
    {
      "id": "d_net_sec",
