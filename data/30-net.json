      "base": [
        {"n": "安全模型与威胁建模", "t": "STRIDE、攻击面分析、最小权限、纵深防御", "l": "—", "s": "Microsoft Threat Modeling Tool"}
      ],
      "branches": [
        {
          "name": "系统与二进制安全",
          "desc": "在内存与指令层面寻找并利用缺陷，是攻防最硬核的战场。",
          "points": [
            {"n": "内存安全与漏洞利用", "t": "栈/堆溢出、UAF、类型混淆、ROP/JOP", "l": "C、汇编", "s": "IDA Pro、Ghidra、pwntools"},
            {"n": "漏洞挖掘", "t": "覆盖率引导模糊测试、符号执行、污点分析、差分测试", "l": "C++、Python", "s": "AFL++、libFuzzer、angr"},
            {"n": "系统加固", "t": "ASLR/DEP/CFI、沙箱、SELinux、可信启动", "l": "—", "s": "SELinux、AppArmor、seccomp"}
          ]
        },
        {
          "name": "Web 与应用安全",
          "desc": "业务逻辑与身份体系是数据泄露的主要入口。",
          "points": [
            {"n": "Web 漏洞与防护", "t": "注入、XSS、SSRF、反序列化、OWASP Top 10", "l": "—", "s": "Burp Suite、OWASP ZAP、Semgrep"},
            {"n": "身份与访问控制", "t": "OAuth2/OIDC、SAML、零信任、RBAC/ABAC", "l": "—", "s": "Keycloak、OPA、Okta"}
          ]
        },
        {
          "name": "攻防对抗与威胁情报",
          "desc": "从单点漏洞走向持续检测、响应与情报运营。",
          "points": [
            {"n": "检测与响应", "t": "IDS/IPS、SIEM、EDR、蜜罐、ATT&CK 映射", "l": "—", "s": "Suricata、Wazuh、ELK、TheHive"},
            {"n": "恶意代码分析", "t": "静态/动态分析、沙箱、YARA 规则、反混淆", "l": "—", "s": "Cuckoo、YARA、CAPA、FLOSS"}
          ]
        },
        {
          "name": "隐私保护与可信计算",
          "desc": "让数据在“可用不可见”的前提下产生价值。",
          "points": [
            {"n": "隐私增强技术", "t": "差分隐私、联邦学习、安全多方计算、k-匿名", "l": "—", "s": "Opacus、FATE、MP-SPDZ"},
            {"n": "可信执行环境", "t": "TPM、SGX/TDX、SEV、机密容器、远程证明", "l": "—", "s": "Intel SGX、AMD SEV、Confidential Containers"}
          ]
        }
      ]
    },
    {
