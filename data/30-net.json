      "base": [
        {"n": "数论与代数基础", "t": "模运算、群环域、椭圆曲线、格、双线性配对", "l": "—", "s": "SageMath、PARI/GP"}
      ],
      "branches": [
        {
          "name": "基础密码原语",
          "desc": "对称、公钥与哈希三类原语构成全部安全协议的积木。",
          "points": [
            {"n": "对称密码", "t": "AES、分组模式（GCM/CCM）、认证加密、流密码", "l": "C", "s": "OpenSSL、libsodium"},
